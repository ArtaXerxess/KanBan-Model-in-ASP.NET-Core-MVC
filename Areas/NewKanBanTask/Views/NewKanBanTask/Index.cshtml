@* KanBan_Model/Areas/NewKanBanTask/Views/NewKanBanTask/Index.cshtml *@
@model KanBan_Model.Models.KanBanCard

@{
    ViewData["Title"] = "New Task";
    Layout = "../Shared/_Layout";
}


<h4>Create A New Task</h4>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post" asp-action="CreateNewTask" asp-controller="NewKanBanTask" asp-area="NewKanBanTask">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @* title *@
            <div class="form-group my-2">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            @* Description *@
            <div class="form-group my-2">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            @* Assignee *@
            <div class="form-group my-2">
                <label asp-for="Assignee" class="control-label"></label>
                <input asp-for="Assignee" class="form-control" />
                <span asp-validation-for="Assignee" class="text-danger"></span>
            </div>

            @* DueDate *@
            <div class="form-group my-2">
                <label asp-for="DueDate" class="control-label"></label>
                <input type="date" asp-for="DueDate" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger"></span>
            </div>

            @* first phase of any kanban task should be ToDo by default *@


            @* Set Priority radio button *@

            <div class="container priority_radio_buttons my-2">

                <h3>Priority</h3>

                <div class="form-check">
                    <input asp-for="Priority" class="form-check-input" type="radio"
                        value="@KanBan_Model.Models.KanBanTaskPriority.Critical" id="Critical" />
                    <label class="form-check-label" for="Critical">Critical</label>
                </div>

                <div class="form-check">
                    <input asp-for="Priority" class="form-check-input" type="radio"
                        value="@KanBan_Model.Models.KanBanTaskPriority.High" id="High" />
                    <label class="form-check-label" for="High">High</label>
                </div>

                <div class="form-check">
                    <input asp-for="Priority" class="form-check-input" type="radio"
                        value="@KanBan_Model.Models.KanBanTaskPriority.Medium" id="Medium" checked />
                    <label class="form-check-label" for="Medium">Medium</label>
                </div>

                <div class="form-check">
                    <input asp-for="Priority" class="form-check-input" type="radio"
                        value="@KanBan_Model.Models.KanBanTaskPriority.Low" id="Low" />
                    <label class="form-check-label" for="Low">Low</label>
                </div>

            </div>


            @* attachments link and docs(textarea) *@

            <h3>Attachments</h3>

            <div class="form-floating mb-3 my-2">
                <input type="text" class="form-control" id="Links" asp-for="Attachment!.Links">
                <label for="Links">Links</label>
            </div>

            <div class="container document_textarea my-2">
                <label for="Documents">Notes</label>
                <textarea asp-for="Attachment!.Document" class="form-control"
                    placeholder="Write your Notes or Documents here..." id="Documents" style="height: 100px">
                </textarea>
            </div>

            @* submit button *@

            <div class="container m-5">
                <button class="btn btn-primary" type="submit">Add New Task</button>
            </div>

        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
